{
  "template_id": "upstreamuitemplate",
  "description": "Upstream UI frontend",
  "template": {
    "pod_id": "{{BASE}}",
    "image": "ghcr.io/wmobley/upstream-ui-pods:main",
    "pod_template": "",
    "description": "Upstream UI frontend",
    "environment_variables": {
      "VITE_UPSTREAM_API_URL": "https://{{BASE}}api.pods.portals.tapis.io",
      "VITE_CKAN_URL": "https://ckan.tacc.utexas.edu",
      "VITE_TAPIS_BASE_URL": "https://portals.tapis.io",
      "VITE_TAPIS_PODS_BASE_URL": "https://portals.tapis.io",
      "UPSTREAM_RELEASE": "{{IMAGE_TAG}}"
    },
    "status_requested": "ON",
    "volume_mounts": {},
    "time_to_stop_default": -1,
    "networking": {
      "default": {
        "protocol": "http",
        "port": 80,
        "url": "{{BASE}}.pods.portals.tapis.io"
      }
    },
    "resources": {
      "cpu_request": 250,
      "cpu_limit": 2000,
      "mem_request": 256,
      "mem_limit": 3072,
      "gpus": 0
    }
  }
}
