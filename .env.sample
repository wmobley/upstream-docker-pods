POSTGRES_USER=fastapi_traefik
POSTGRES_PASSWORD=fastapi_traefik
TAS_USER=CHANGE_ME
TAS_SECRET=CHANGE_ME
JWT_SECRET=test_secret
ALG=HS256
TAS_URL=https://tas-dev.tacc.utexas.edu/api-test
TAPIS_BASE_URL=https://tacc.tapis.io
TAPIS_TENANT_ID=tacc
TAPIS_ENFORCE_AUTH_IN_DEV=false
ENVIRONMENT=dev
ENV=dev

# Default: local Postgres instance (adjust host/port as needed)
DATABASE_URL=postgresql+psycopg://fastapi_traefik@localhost:5432/fastapi_traefik

# Web UI and API endpoints (used for CKAN resource links)
UI_BASE_URL=http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8000

# Optional CKAN integration
CKAN_URL=
CKAN_ORGANIZATION=

# Optional: remote Pods Postgres connection (uncomment and set values to enable)
# PODS_DB_HOST=disasterpostgres.pods.tacc.tapis.io
# PODS_DB_PORT=443
# PODS_DB_USER=fastapi_traefik
# PODS_DB_PASSWORD=fastapi_traefik
# PODS_DB_NAME=fastapi_traefik
# DATABASE_URL=postgresql+psycopg://${PODS_DB_USER}:${PODS_DB_PASSWORD}@${PODS_DB_HOST}:${PODS_DB_PORT}/${PODS_DB_NAME}?sslmode=require
